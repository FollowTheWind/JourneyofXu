            {
              "pairId": "yands-p01-s01",
              "original": "自乐清入山，群峰森列，若屏若戟。",
              "translation": "从**乐清**进入山中，只见群峰密密排列，有的像屏风，有的像长戟。",
              "keywords": ["乐清", "群峰"]
            },
            {
              "pairId": "yands-p01-s02",
              "original": "仰视不见其巅，云气出没其间。",
              "translation": "仰头望去，看不见峰顶，云气在山峰之间时隐时现。",
              "keywords": ["峰顶", "云气"]
            }
          ]
        },
